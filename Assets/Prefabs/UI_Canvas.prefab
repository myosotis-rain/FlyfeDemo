  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InstructionBox
  instructionTextComponent: {fileID: 6515500500939439039}
  instructionsContent: "--- Controls Summary ---\nAction    Key(s)    Description\n--------------------------------------------------------------------------------\nMove\t\tWASD
    / Arrows\tWalk (Press \u2193 to drop down or climb).\nJump\t\tSpace / W / \u2191\tStandard
    jump.\nRecord\tLeft Shift\t\tToggle Shadow recording (Start/Stop).\nReplay \tR\t\t\tSummon
    and restart the Shadow's playback.\nSkill\t\tF\t\t\tTrigger your active Friend
    Skill.\nInteract\tE\t\t\tTrigger Interactive Components (eg. read, pulling levers)."
  startVisible: 1
